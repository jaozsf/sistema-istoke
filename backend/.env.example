APP_NAME=StockIQ
APP_VERSION=1.0.0
DEBUG=true

# Se for usar docker compose, host "db" (nome do serviço). Se rodar sem
# Docker, use "localhost".
DATABASE_URL=postgresql+asyncpg://postgres:senha@db:5432/stockiq
DATABASE_URL_SYNC=postgresql://postgres:senha@db:5432/stockiq

# Gere uma string aleatoria longa (ex: `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Caminho do arquivo baixado em Firebase Console > Configuracoes do projeto
# > Contas de servico > Gerar nova chave privada. Precisa estar dentro da
# pasta backend/ (mesmo nivel deste .env), não na raiz do repositório.
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=

# Opcional: sem chave de IA o Assistente só responde perguntas que batem
# com um padrão conhecido (estoque baixo, produto parado, etc). Com a chave,
# qualquer outra dúvida vai pro modelo.
# Grátis, sem cartão (basta uma; Groq tem prioridade):
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# Alternativa paga: Claude (Anthropic)
ANTHROPIC_API_KEY=

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
